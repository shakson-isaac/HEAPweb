# Flask backend on Cloud Run: legacy interactive plots, downloads, and the
# paginated Cloud SQL tables used by the original result pages.
REACT_APP_BACKEND_URL=https://your-backend-xxxxx.run.app

# Public bucket holding the sharded result payloads built by tools/build_payload.py.
# Not a secret; override only if the bucket moves.
REACT_APP_WEB_DATA_URL=https://storage.googleapis.com/heap-web-data/web/v1
